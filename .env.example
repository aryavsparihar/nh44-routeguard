# Copy this file to .env.local and fill in the values from the Supabase dashboard.
# Never commit .env.local. Only this example file (names, no values) is committed.

# --- Next.js app: .env.local, and the deploy workflow at build time ---
# Public by design: these are sent to the browser. RLS protects the data.
# API URL, like https://<project-ref>.supabase.co (not the supabase.com/dashboard link)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Clerk (login and roles): .env.local, and Container Apps secrets ---
# From the Clerk dashboard, application app_3MY5xJ8fczFe0sOEafACBTW6tNY,
# API keys page. Leave both blank and the app runs with everyone signed out.
# Public by design: the publishable key (pk_test_... / pk_live_...) goes to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# SECRET, server only. Never in a NEXT_PUBLIC_ variable or client code.
CLERK_SECRET_KEY=
# Keep this at 1. Without keys in development, Clerk would otherwise create
# a throwaway "keyless" Clerk application on its own.
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=1
# Stops the Clerk SDK sending usage data (telemetry) to Clerk from development.
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1

# --- Server settings (optional) ---
# Log level for the API logs: trace, debug, info (default), warn, error, silent.
# Used in src/server/http/logger.ts. Not secret.
LOG_LEVEL=
# Set to 1 to send the Content-Security-Policy as report-only (the browser
# logs violations but blocks nothing). Emergency switch for deploy day only;
# read at build time in src/server/security-headers.ts. Not secret.
CSP_REPORT_ONLY=
# The commit SHA of a deployed build (next.config.ts deploymentId). Set by the
# deploy workflow at build time; leave blank on your machine. Not secret.
DEPLOYMENT_VERSION=

# --- Python hourly job: GitHub Actions secrets ONLY ---
# Never put these in the hosting settings, app code, or any NEXT_PUBLIC_ variable.
# The secret key bypasses RLS. Leave them blank here unless you are running
# jobs/run_risk.py on your own machine.
# SUPABASE_URL=            # same https://<project-ref>.supabase.co URL
# SUPABASE_SECRET_KEY=
