# Copy this file to .env.local and fill in the values from the Supabase dashboard.
# Never commit .env.local. Only this example file (names, no values) is committed.

# --- Next.js app: .env.local and Vercel (Production, Preview, Development) ---
# Public by design: these are sent to the browser. RLS protects the data.
# API URL, like https://<project-ref>.supabase.co (not the supabase.com/dashboard link)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Python hourly job: GitHub Actions secrets ONLY ---
# Never put these in Vercel, app code, or any NEXT_PUBLIC_ variable.
# The secret key bypasses RLS. Leave them blank here unless you are running
# jobs/run_risk.py on your own machine.
# SUPABASE_URL=            # same https://<project-ref>.supabase.co URL
# SUPABASE_SECRET_KEY=
