# Keep keys, local builds and team notes out of the Docker build context.
# The image only needs the Next.js app (see Dockerfile).
.env*
!.env.example
.git
.github
.next
node_modules
**/.venv*
.vercel
.DS_Store
.pytest_cache
*.tsbuildinfo
coverage
# The app reads two files from these folders (weather point names, the road line).
jobs/*
!jobs/points.json
supabase
data/*
!data/nh44_line.json
docs
team-guides
ui ux round
test
seed.mjs
