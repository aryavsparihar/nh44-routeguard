    "brand.navy": "#28557A",
    "send.fill": "#1E5631",
    "send.bg": "#DCFCE7",
    "send.text": "#14532D",
    "hold.fill": "#B8862D",
    "hold.bg": "#FEF3C7",
    "hold.text": "#78350F",
