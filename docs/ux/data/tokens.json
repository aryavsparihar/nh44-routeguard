  "rejected_pairs": [
    {
      "fg": "text.inverse",
      "bg": "hold.fill",
      "why": "white on HOLD amber is 3.85:1, so HOLD never puts white text on its fill colour"
    },
    {
      "fg": "text.inverse",
      "bg": "brand.milestone",
      "why": "white on milestone yellow is 1.6:1, so the yellow only ever carries black text, as on a real milestone"
    },
    {
      "fg": "brand.milestone",
      "bg": "bg.canvas",
      "why": "1.62:1, so yellow is never used for text; warning text uses brand.milestone.ink"
    },
    {
      "fg": "hold.fill",
      "bg": "bg.map",
      "why": "2.89:1 on the map, so medium hexagons use risk.medium.map"
    }
  ]
