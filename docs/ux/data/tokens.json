  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32, "12": 48 },
  "radius": { "sm": 4, "md": 8, "lg": 16, "pill": 999 },
  "touch_min_px": 48,
  "type": {
    "display": { "family": "Merriweather", "fallback": "Georgia, serif", "size": 28, "line": 36, "weight": 700 },
    "h1": { "family": "Merriweather", "fallback": "Georgia, serif", "size": 22, "line": 30, "weight": 700 },
    "h2": { "family": "Inter", "fallback": "system-ui, sans-serif", "size": 18, "line": 24, "weight": 600 },
    "body": { "family": "Inter", "fallback": "system-ui, sans-serif", "size": 14, "line": 20, "weight": 400 },
    "input": { "family": "Inter", "fallback": "system-ui, sans-serif", "size": 16, "line": 24, "weight": 400 },
    "label": { "family": "Inter", "fallback": "system-ui, sans-serif", "size": 12, "line": 16, "weight": 600, "upper": true, "tracking": 0.06 },
    "data": { "family": "JetBrains Mono", "fallback": "ui-monospace, Menlo, monospace", "size": 14, "line": 20, "weight": 500 }
  },
  "contrast_pairs": [
    { "fg": "text.primary", "bg": "bg.canvas", "use": "body text", "min": 4.5 },
    { "fg": "text.primary", "bg": "bg.surface", "use": "body text on cards", "min": 4.5 },
    { "fg": "text.primary", "bg": "bg.map", "use": "map labels", "min": 4.5 },
    { "fg": "text.secondary", "bg": "bg.canvas", "use": "secondary text", "min": 4.5 },
    { "fg": "text.secondary", "bg": "bg.surface", "use": "secondary text on cards", "min": 4.5 },
    { "fg": "text.secondary", "bg": "bg.elevated", "use": "secondary text on sheets", "min": 4.5 },
    { "fg": "brand.terracotta.ink", "bg": "bg.canvas", "use": "links and accent text", "min": 4.5 },
    { "fg": "brand.terracotta.ink", "bg": "bg.surface", "use": "accent text on cards", "min": 4.5 },
    { "fg": "brand.ochre.ink", "bg": "bg.canvas", "use": "warning text", "min": 4.5 },
    { "fg": "text.inverse", "bg": "brand.teal", "use": "primary button label", "min": 7.0 },
    { "fg": "text.inverse", "bg": "brand.navy", "use": "secondary button label", "min": 4.5 },
    { "fg": "text.inverse", "bg": "text.primary", "use": "offline banner", "min": 7.0 },
    { "fg": "text.inverse", "bg": "brand.terracotta.ink", "use": "report button label", "min": 4.5 },
    { "fg": "text.inverse", "bg": "high.fill", "use": "closure banner label", "min": 4.5 },
    { "fg": "send.text", "bg": "send.bg", "use": "SEND decision badge", "min": 7.0, "decision": true },
    { "fg": "hold.text", "bg": "hold.bg", "use": "HOLD decision badge", "min": 7.0, "decision": true },
    { "fg": "rail.text", "bg": "rail.bg", "use": "RAIL decision badge", "min": 7.0, "decision": true },
    { "fg": "divert.text", "bg": "divert.bg", "use": "DIVERT decision badge", "min": 7.0, "decision": true },
    { "fg": "high.text", "bg": "high.bg", "use": "HIGH risk badge", "min": 7.0, "decision": true },
    { "fg": "text.primary", "bg": "send.bg", "use": "body text in SEND card", "min": 4.5 },
    { "fg": "text.primary", "bg": "hold.bg", "use": "body text in HOLD card", "min": 4.5 },
    { "fg": "text.primary", "bg": "rail.bg", "use": "body text in RAIL card", "min": 4.5 },
    { "fg": "text.primary", "bg": "divert.bg", "use": "body text in DIVERT card", "min": 4.5 },
    { "fg": "text.primary", "bg": "high.bg", "use": "body text in HIGH card", "min": 4.5 },
    { "fg": "risk.low.map", "bg": "bg.map", "use": "low-risk hexagon fill (graphic)", "min": 3.0 },
    { "fg": "risk.medium.map", "bg": "bg.map", "use": "medium-risk hexagon fill (graphic)", "min": 3.0 },
    { "fg": "risk.high.map", "bg": "bg.map", "use": "high-risk hexagon fill (graphic)", "min": 3.0 },
    { "fg": "border.strong", "bg": "bg.elevated", "use": "form field border (graphic)", "min": 3.0 },
    { "fg": "send.fill", "bg": "bg.elevated", "use": "decision stripe (graphic)", "min": 3.0 },
    { "fg": "hold.fill", "bg": "bg.elevated", "use": "decision stripe (graphic)", "min": 3.0 },
    { "fg": "rail.fill", "bg": "bg.elevated", "use": "decision stripe (graphic)", "min": 3.0 },
    { "fg": "divert.fill", "bg": "bg.elevated", "use": "decision stripe (graphic)", "min": 3.0 }
  ],
  "rejected_pairs": [
    { "fg": "text.inverse", "bg": "hold.fill", "why": "white on ochre is 3.24:1, so HOLD never puts text on its fill colour" },
    { "fg": "text.inverse", "bg": "divert.fill", "why": "white on terracotta is 4.23:1, so DIVERT text uses divert.text on divert.bg" },
    { "fg": "brand.terracotta", "bg": "bg.canvas", "why": "4.00:1, so small accent text uses brand.terracotta.ink" },
    { "fg": "brand.ochre", "bg": "bg.canvas", "why": "3.06:1, so warning text uses brand.ochre.ink" },
    { "fg": "hold.fill", "bg": "bg.map", "why": "2.57:1 on the map, so medium hexagons use risk.medium.map" }
  ]
}
