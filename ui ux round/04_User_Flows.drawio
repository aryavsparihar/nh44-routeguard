<mxCell id="uf_D4" value="Send 6-digit OTP by&lt;br&gt;SMS (valid 5 min)" style="rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#15191C;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#15191C;" vertex="1" parent="uf_D_L3"><mxGeometry x="410" y="70" width="190" height="60" as="geometry"/></mxCell>
